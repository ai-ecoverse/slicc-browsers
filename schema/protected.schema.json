{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-ecoverse/slicc-browsers/schema/protected.schema.json",
  "title": "slicc-browsers protected-origin test vectors, schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "origins", "urls", "targets", "cookieDomains", "storageKeys"],
  "properties": {
    "schema": { "const": 1 },
    "origins": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "urls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "protected"],
        "properties": {
          "url": { "type": "string" },
          "protected": { "type": "boolean" }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "protected"],
        "properties": {
          "url": { "type": "string" },
          "type": { "type": "string" },
          "previous": { "type": "boolean" },
          "opener": { "enum": ["protected", "unprotected", "unknown"] },
          "protected": { "type": "boolean" }
        }
      }
    },
    "cookieDomains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "protected"],
        "properties": {
          "domain": { "type": "string" },
          "protected": { "type": "boolean" }
        }
      }
    },
    "storageKeys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "protected"],
        "properties": {
          "key": { "type": "string" },
          "protected": { "type": "boolean" }
        }
      }
    }
  }
}
