{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-ecoverse/slicc-browsers/schema/guard-vectors.schema.json",
  "title": "slicc-browsers guard vectors, schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "setVersion",
    "sources",
    "targets",
    "variants",
    "capabilities",
    "placeholders",
    "vectors"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "setVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "ref", "path"],
        "properties": {
          "repo": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "required": ["seven", "vault", "vault-x", "apex", "own", "ordinary", "ordinary-same-site"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "host": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "url": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9+.-]*://\\S+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "variants": {
      "type": "object",
      "required": ["prompt", "lagging"],
      "propertyNames": {
        "pattern": "^[a-z0-9-]+$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "autoAttach",
        "browserSession",
        "browserContexts",
        "chromeUrlsAttach",
        "extensionWorld",
        "discovery",
        "clientExit"
      ],
      "properties": {
        "autoAttach": {
          "type": "string",
          "minLength": 1
        },
        "browserSession": {
          "type": "string",
          "minLength": 1
        },
        "browserContexts": {
          "type": "string",
          "minLength": 1
        },
        "extensionWorld": { "type": "string", "minLength": 1 },
        "discovery": { "type": "string", "minLength": 1 },
        "chromeUrlsAttach": {
          "type": "string",
          "minLength": 1
        },
        "clientExit": { "type": "string", "minLength": 1 }
      }
    },
    "placeholders": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vector"
      }
    }
  },
  "$defs": {
    "capability": {
      "enum": [
        "autoAttach",
        "browserSession",
        "browserContexts",
        "chromeUrlsAttach",
        "extensionWorld",
        "discovery",
        "clientExit"
      ]
    },
    "requires": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["means", "check"],
      "properties": {
        "means": {
          "type": "string",
          "minLength": 1
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(refused\\.[0-9]+|[A-Za-z][A-Za-z0-9]*)$"
          }
        },
        "requires": {
          "$ref": "#/$defs/requires"
        },
        "check": {
          "$ref": "#/$defs/check"
        },
        "eitherWhen": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "target": {
      "enum": [
        "ordinary",
        "seven",
        "vault",
        "vault-x",
        "apex",
        "own",
        "chrome-newtab",
        "chrome-new-tab-page",
        "chrome-settings",
        "chrome-passwords",
        "chrome-search",
        "network-error",
        "chrome-extension-page",
        "file-root"
      ]
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "const": "either"
              }
            ]
          }
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "kind",
        "scope",
        "setup",
        "trigger",
        "targets",
        "live",
        "control",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[CEBX][1-9](\\.[A-Za-z0-9-]+)*$"
        },
        "family": {
          "enum": ["C", "E", "B", "X"]
        },
        "kind": {
          "enum": ["cdp", "text"]
        },
        "scope": {
          "type": "string",
          "pattern": "^(any|[a-z][a-z0-9-]*)$"
        },
        "setup": {
          "$ref": "#/$defs/steps"
        },
        "trigger": {
          "$ref": "#/$defs/steps"
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/target"
          }
        },
        "requires": {
          "$ref": "#/$defs/requires"
        },
        "observe": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/observation"
          }
        },
        "live": {
          "type": "string",
          "minLength": 1
        },
        "control": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "via", "expected"],
          "properties": {
            "origin": {
              "const": "ordinary"
            },
            "via": {
              "enum": ["guard", "unguarded"]
            },
            "expected": {
              "$ref": "#/$defs/expected"
            }
          }
        },
        "expected": {
          "$ref": "#/$defs/expected"
        },
        "skip": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "reason"],
          "properties": {
            "target": {
              "$ref": "#/$defs/target"
            },
            "reason": {
              "type": "string",
              "pattern": "^[a-z][a-z-]*: .+"
            }
          }
        },
        "defaultContext": {
          "const": true
        },
        "designDependent": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "own": {
              "type": "boolean"
            }
          }
        },
        "appliesTo": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": ["href", "iframe", "popup", "redirect"]
          }
        },
        "liveCheck": {
          "$ref": "#/$defs/liveCheck"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cdp"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["liveCheck"]
          }
        },
        {
          "if": {
            "properties": {
              "observe": {
                "type": "object",
                "required": ["hopped"]
              }
            },
            "required": ["observe"]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "setup": {
                    "type": "array",
                    "contains": {
                      "$ref": "#/$defs/hopStep"
                    }
                  }
                }
              },
              {
                "properties": {
                  "trigger": {
                    "type": "array",
                    "contains": {
                      "$ref": "#/$defs/hopStep"
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "on": {
      "enum": ["control", "guarded"]
    },
    "session": {
      "enum": ["page", "browser", "page-or-browser", "child"]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9]*$"
    },
    "method": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z]*\\.[a-z][A-Za-z]*$"
    },
    "hops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["origin", "code"],
        "properties": {
          "origin": {
            "type": "string"
          },
          "code": {
            "type": "integer",
            "minimum": 300,
            "maximum": 399
          }
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["redirectSecret", "as"],
          "properties": {
            "redirectSecret": { "enum": ["headers", "mix", "body"] },
            "as": { "$ref": "#/$defs/name" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["errorPage", "as"],
          "properties": {
            "errorPage": { "enum": ["recover", "restore", "sticky"] },
            "secret": { "enum": ["all", "query", "fragment"] },
            "requires": { "$ref": "#/$defs/requires" },
            "as": { "$ref": "#/$defs/name" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["unparseable", "as"],
          "properties": {
            "unparseable": {
              "const": true
            },
            "as": {
              "$ref": "#/$defs/name"
            },
            "requires": {
              "$ref": "#/$defs/requires"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["extensionWorld", "as", "requires"],
          "properties": {
            "extensionWorld": {
              "enum": ["hidden", "select", "debugger", "drivable"]
            },
            "as": {
              "$ref": "#/$defs/name"
            },
            "requires": {
              "$ref": "#/$defs/requires"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["client"],
          "properties": {
            "client": { "const": "exit" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text"],
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "on": {
              "$ref": "#/$defs/on"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cdp"],
          "properties": {
            "cdp": {
              "$ref": "#/$defs/method"
            },
            "params": {
              "type": "object"
            },
            "session": {
              "$ref": "#/$defs/session"
            },
            "as": {
              "$ref": "#/$defs/name"
            },
            "on": {
              "$ref": "#/$defs/on"
            },
            "requires": {
              "$ref": "#/$defs/requires"
            },
            "refusable": {
              "const": true
            },
            "refusal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["match"],
              "properties": {
                "onlyProtected": {
                  "type": "boolean"
                },
                "match": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "dependentRequired": {
            "refusable": ["refusal"],
            "refusal": ["refusable"]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["page"],
          "properties": {
            "page": {
              "enum": [
                "tab",
                "navigate",
                "href",
                "replace",
                "form",
                "post",
                "open",
                "iframe",
                "framed",
                "fetch",
                "xhr",
                "image",
                "script",
                "eval"
              ]
            },
            "url": {
              "type": "string"
            },
            "hops": {
              "$ref": "#/$defs/hops"
            },
            "from": {
              "type": "string"
            },
            "context": {
              "type": "string"
            },
            "expression": {
              "type": "string"
            },
            "credentials": {
              "const": "include"
            },
            "status": {
              "type": "boolean"
            },
            "background": {
              "type": "boolean"
            },
            "session": {
              "$ref": "#/$defs/session"
            },
            "as": {
              "$ref": "#/$defs/name"
            },
            "on": {
              "$ref": "#/$defs/on"
            },
            "requires": {
              "$ref": "#/$defs/requires"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["answer"],
          "properties": {
            "answer": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url"],
              "properties": {
                "url": {
                  "type": "string"
                },
                "stage": {
                  "enum": ["Request", "Response"]
                },
                "cdp": {
                  "$ref": "#/$defs/method"
                },
                "params": {
                  "type": "object"
                },
                "hold": {
                  "const": true
                }
              }
            },
            "on": {
              "$ref": "#/$defs/on"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["children"],
          "properties": {
            "children": {
              "$ref": "#/$defs/steps"
            },
            "where": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["openerId"],
                  "properties": { "openerId": { "const": "page" } }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["urlPrefix"],
                  "properties": { "urlPrefix": { "type": "string", "minLength": 1 } }
                }
              ]
            },
            "on": {
              "$ref": "#/$defs/on"
            },
            "requires": {
              "$ref": "#/$defs/requires"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["settle"],
          "properties": {
            "settle": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "beacon": {
                  "type": "string"
                },
                "served": {
                  "type": "string"
                },
                "or": {
                  "$ref": "#/$defs/check"
                },
                "title": {
                  "type": "string"
                },
                "ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "variant": {
                  "const": true
                },
                "session": {
                  "$ref": "#/$defs/session"
                },
                "required": {
                  "const": true
                },
                "dependsOn": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^(refused\\.[0-9]+|[A-Za-z][A-Za-z0-9]*)$"
                  }
                }
              }
            },
            "requires": {
              "$ref": "#/$defs/requires"
            },
            "on": {
              "$ref": "#/$defs/on"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["paused"],
          "properties": {
            "paused": {
              "type": "object",
              "additionalProperties": false,
              "required": ["url", "ms"],
              "properties": {
                "url": {
                  "type": "string"
                },
                "ms": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "on": {
              "$ref": "#/$defs/on"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["wait"],
          "properties": {
            "wait": {
              "type": "integer",
              "minimum": 0
            },
            "on": {
              "$ref": "#/$defs/on"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["guess", "as"],
          "properties": {
            "guess": {
              "type": "object",
              "additionalProperties": false,
              "required": ["between", "cdp", "params"],
              "properties": {
                "between": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "cdp": {
                  "$ref": "#/$defs/method"
                },
                "params": {
                  "type": "object"
                }
              }
            },
            "as": {
              "$ref": "#/$defs/name"
            },
            "on": {
              "$ref": "#/$defs/on"
            }
          }
        }
      ]
    },
    "check": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["beacon", "observer"],
          "properties": {
            "beacon": {
              "type": "string"
            },
            "observer": {
              "const": "fixture"
            },
            "exit": {
              "enum": ["before", "after"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["served", "observer"],
          "properties": {
            "served": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "observer": {
              "const": "fixture"
            },
            "tagged": {
              "type": "boolean"
            },
            "exit": {
              "enum": ["before", "after"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["header", "on", "observer"],
          "properties": {
            "header": {
              "type": "string"
            },
            "on": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "observer": {
              "const": "fixture"
            },
            "exit": {
              "enum": ["before", "after"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["event", "observer"],
          "properties": {
            "event": {
              "type": "string"
            },
            "where": {
              "$ref": "#/$defs/predicate"
            },
            "observer": {
              "const": "client"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "equals", "observer"],
          "properties": {
            "result": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "equals": {
              "$ref": "#/$defs/predicate"
            },
            "observer": {
              "const": "client"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["cookie", "from", "observer"],
          "properties": {
            "cookie": {
              "type": "string"
            },
            "from": {
              "type": "string"
            },
            "observer": {
              "const": "client"
            },
            "on": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["compare", "path", "observer"],
          "properties": {
            "compare": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "path": {
              "type": "string"
            },
            "observer": {
              "const": "client"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["refused", "observer"],
          "properties": {
            "refused": {
              "$ref": "#/$defs/callNames"
            },
            "refusal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["match"],
              "properties": {
                "match": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "observer": {
              "const": "client"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reached", "observer"],
          "properties": {
            "reached": {
              "$ref": "#/$defs/callNames"
            },
            "observer": {
              "const": "client"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["attached", "observer"],
          "properties": {
            "attached": {
              "type": "string"
            },
            "session": {
              "$ref": "#/$defs/session"
            },
            "observer": {
              "const": "client"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["delivered", "observer"],
          "properties": {
            "delivered": {
              "type": "string"
            },
            "observer": {
              "const": "client"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "via", "observer"],
          "properties": {
            "title": {
              "type": "string"
            },
            "via": {
              "const": "unguarded"
            },
            "session": {
              "$ref": "#/$defs/session"
            },
            "observer": {
              "const": "unguarded"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["expression", "equals", "via", "observer"],
          "properties": {
            "expression": {
              "type": "string"
            },
            "equals": {
              "$ref": "#/$defs/predicate"
            },
            "via": {
              "const": "unguarded"
            },
            "session": {
              "$ref": "#/$defs/session"
            },
            "observer": {
              "const": "unguarded"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all", "observer"],
          "properties": {
            "all": {
              "$ref": "#/$defs/checks"
            },
            "observer": {
              "const": "client"
            }
          }
        },
        {
          "type": "object",
