{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-ecoverse/slicc-browsers/schema/debugger-stage1.schema.json",
  "title": "slicc-browsers Stage 1 debugger conformance vectors, schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "methods", "rows", "navigation", "leaseRefusals", "rescueEvidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["method", "lifetime", "admitted"],
        "properties": {
          "method": { "$ref": "#/$defs/name" },
          "lifetime": { "enum": ["persistent", "document", "cleanup", "pause-control", "unknown"] },
          "admitted": { "type": "boolean" },
          "ownedInstrumentationOnly": { "type": "boolean" }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "mode", "destination", "expected", "requires"],
        "properties": {
          "id": { "$ref": "#/$defs/name" },
          "mode": { "$ref": "#/$defs/name" },
          "destination": { "$ref": "#/$defs/name" },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["admitted", "released"],
            "properties": {
              "admitted": { "type": "boolean" },
              "published": { "type": "boolean" },
              "installed": { "type": "boolean" },
              "liveReads": { "type": "boolean" },
              "released": { "type": "boolean" },
              "converted": { "type": "boolean" },
              "committed": { "type": "boolean" },
              "forwarded": { "type": "boolean" }
            }
          },
          "requires": { "$ref": "#/$defs/names" }
        }
      }
    },
    "navigation": { "$ref": "#/$defs/names" },
    "leaseRefusals": { "$ref": "#/$defs/names" },
    "rescueEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "noObserverResume",
        "ownerUnchanged",
        "generationUnchanged",
        "deadlineUnchanged"
      ],
      "properties": {
        "origin": { "$ref": "#/$defs/name" },
        "noObserverResume": { "type": "boolean" },
        "ownerUnchanged": { "type": "boolean" },
        "generationUnchanged": { "type": "boolean" },
        "deadlineUnchanged": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1 },
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    }
  }
}
