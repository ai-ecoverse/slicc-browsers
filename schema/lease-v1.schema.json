{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-ecoverse/slicc-browsers/schema/lease-v1.schema.json",
  "title": "Signed CDP lease v1 link message (see $defs for JWT and adapter types)",
  "oneOf": [
    {
      "$ref": "#/$defs/initialOpen"
    },
    {
      "$ref": "#/$defs/expansionOpen"
    },
    {
      "$ref": "#/$defs/dataOpen"
    },
    {
      "$ref": "#/$defs/opened"
    },
    {
      "$ref": "#/$defs/proof"
    },
    {
      "$ref": "#/$defs/pending"
    },
    {
      "$ref": "#/$defs/grant"
    },
    {
      "$ref": "#/$defs/ready"
    },
    {
      "$ref": "#/$defs/action"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "handle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "jwk": {
      "type": "object",
      "properties": {
        "kty": {
          "const": "OKP"
        },
        "crv": {
          "const": "Ed25519"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": ["kty", "crv", "x"],
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": ["origin", "exact", "path-prefix"]
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": ["kind", "url"],
      "additionalProperties": false
    },
    "allow": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "header": {
      "type": "object",
      "properties": {
        "typ": {
          "const": "slicc-cdp-lease+jwt"
        },
        "alg": {
          "const": "Ed25519"
        }
      },
      "required": ["typ", "alg"],
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "properties": {
        "iss": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "aud": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "jti": {
          "$ref": "#/$defs/handle"
        },
        "exp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cnf": {
          "type": "object",
          "properties": {
            "jkt": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          },
          "required": ["jkt"],
          "additionalProperties": false
        },
        "browser_session": {
          "$ref": "#/$defs/handle"
        },
        "allow": {
          "$ref": "#/$defs/allow"
        }
      },
      "required": ["iss", "aud", "jti", "exp", "cnf", "browser_session", "allow"],
      "additionalProperties": false
    },
    "jwt": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{86}$",
      "maxLength": 65536
    },
    "initialOpen": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "cdp-lease-v1"
        },
        "mode": {
          "const": "request"
        },
        "jwk": {
          "$ref": "#/$defs/jwk"
        },
        "allow": {
          "$ref": "#/$defs/allow"
        },
        "ttlSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["kind", "mode", "jwk", "allow", "ttlSeconds"],
      "additionalProperties": false
    },
    "expansionOpen": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "cdp-lease-v1"
        },
        "mode": {
          "const": "request"
        },
        "jwk": {
          "$ref": "#/$defs/jwk"
        },
        "allow": {
          "$ref": "#/$defs/allow"
        },
        "parent": {
          "$ref": "#/$defs/handle"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["kind", "mode", "jwk", "allow", "parent"],
      "additionalProperties": false
    },
    "dataOpen": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "cdp-lease-v1"
        },
        "mode": {
          "const": "data"
        },
        "jwk": {
          "$ref": "#/$defs/jwk"
        },
        "jwt": {
          "$ref": "#/$defs/jwt"
        }
      },
      "required": ["kind", "mode", "jwk", "jwt"],
      "additionalProperties": false
    },
    "opened": {
      "type": "object",
      "properties": {
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "required": ["nonce"],
      "additionalProperties": false
    },
    "proof": {
      "type": "object",
      "properties": {
        "type": {
          "const": "proof"
        },
        "sig": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "required": ["type", "sig"],
      "additionalProperties": false
    },
    "pending": {
      "type": "object",
      "properties": {
        "type": {
          "const": "pending"
        },
        "request": {
          "$ref": "#/$defs/handle"
        }
      },
      "required": ["type", "request"],
      "additionalProperties": false
    },
    "grant": {
      "type": "object",
      "properties": {
        "type": {
          "const": "grant"
        },
        "request": {
          "$ref": "#/$defs/handle"
        },
        "jwt": {
          "$ref": "#/$defs/jwt"
        }
      },
      "required": ["type", "request", "jwt"],
      "additionalProperties": false
    },
    "ready": {
      "type": "object",
      "properties": {
        "type": {
          "const": "ready"
        }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "empty": {
      "type": "object",
      "maxProperties": 0
    },
    "goto": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": ["url"],
      "additionalProperties": false
    },
    "click": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/handle"
        }
      },
      "required": ["ref"],
      "additionalProperties": false
    },
    "fill": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/handle"
        },
        "value": {
          "type": "string",
          "maxLength": 65536
        }
      },
      "required": ["ref", "value"],
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "action"
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "goto"
            },
            "args": {
              "$ref": "#/$defs/goto"
            }
          },
          "required": ["type", "id", "op", "args"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "action"
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "snapshot"
            },
            "args": {
              "$ref": "#/$defs/empty"
            }
          },
          "required": ["type", "id", "op", "args"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "action"
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "click"
            },
            "args": {
              "$ref": "#/$defs/click"
            }
          },
          "required": ["type", "id", "op", "args"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "action"
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "op": {
              "const": "fill"
            },
            "args": {
              "$ref": "#/$defs/fill"
            }
          },
          "required": ["type", "id", "op", "args"],
          "additionalProperties": false
        }
      ]
    },
    "result": {
      "type": "object",
      "properties": {
        "type": {
          "const": "result"
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/empty"
            },
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 65536
                }
              },
              "required": ["text"],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": ["type", "id", "result"],
      "additionalProperties": false
    },
    "reason": {
      "type": "string",
      "pattern": "^E_[A-Z][A-Z0-9_]{0,31}$"
    },
    "error": {
      "type": "object",
      "properties": {
        "type": {
          "const": "error"
        },
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": ["type", "reason", "message"],
      "additionalProperties": false
    },
    "facadeRequest": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "allow": {
              "$ref": "#/$defs/allow"
            },
            "ttlSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": ["allow", "ttlSeconds"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "allow": {
              "$ref": "#/$defs/allow"
            },
            "lease": {
              "$ref": "#/$defs/handle"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": ["allow", "lease"],
          "additionalProperties": false
        }
      ]
    },
    "facadeAction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "lease": {
              "$ref": "#/$defs/handle"
            },
            "op": {
              "const": "goto"
            },
            "args": {
              "$ref": "#/$defs/goto"
            }
          },
          "required": ["lease", "op", "args"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lease": {
              "$ref": "#/$defs/handle"
            },
            "op": {
              "const": "snapshot"
            },
            "args": {
              "$ref": "#/$defs/empty"
            }
          },
          "required": ["lease", "op", "args"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lease": {
              "$ref": "#/$defs/handle"
            },
            "op": {
              "const": "click"
            },
            "args": {
              "$ref": "#/$defs/click"
            }
          },
          "required": ["lease", "op", "args"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "lease": {
              "$ref": "#/$defs/handle"
            },
            "op": {
              "const": "fill"
            },
            "args": {
              "$ref": "#/$defs/fill"
            }
          },
          "required": ["lease", "op", "args"],
          "additionalProperties": false
        }
      ]
    }
  }
}
